<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera hardware optional for wider device compatibility -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_water_drop"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_water_drop"
        android:supportsRtl="true"
        android:theme="@style/Theme.AquaDrop"
        tools:targetApi="34">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDQEVDem3VXDt-DgD29dVaoCwmAxG3YZ7k" />

        <!-- Splash / Launcher Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AquaDrop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Role Dashboards -->
        <activity
            android:name=".activities.BuyerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SellerDashboardActivity"
            android:exported="false" />

        <!-- Geolocation & Tracking -->
        <activity
            android:name=".activities.LiveTrackingActivity"
            android:exported="false" />

        <!-- Background Location Broadcast Service -->
        <service
            android:name=".services.LocationBroadcastService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Root package aliases for full backward-compatibility -->
        <activity
            android:name=".BuyerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".SellerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".LiveTrackingActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <service
            android:name=".LocationBroadcastService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>

